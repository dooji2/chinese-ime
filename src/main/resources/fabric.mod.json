{
	"schemaVersion": 1,
	"id": "chineseime",
	"version": "${version}",
	"name": "Chinese IME",
	"description": "A Minecraft mod that adds pinyin input for typing Chinese characters.",
	"authors": [
		"Dooji"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/chinese-ime",
		"sources": "https://github.com/dooji2/chinese-ime"
	},
	"license": "GPL-v3",
	"icon": "assets/chineseime/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.dooji.chineseime.ChineseIME"
		]
	},
	"mixins": [
        {
            "config": "chineseime.mixins.json",
            "environment": "client"
        }
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"minecraft": ">=1.21 <=1.21.5",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}